local recentJobs = {}
local recentJobsN = 0

local function markRecentJob(id)
    if not id or recentJobs[id] then return end
    recentJobs[id] = true
    recentJobsN = recentJobsN + 1
    if recentJobsN > 200 then                 -- jangan tumbuh tanpa batas
        recentJobs = { [id] = true }
        recentJobsN = 1
    end
end

-- Roblox TIDAK punya sort by jumlah pemain (sortOrder cuma arah paging cursor),
-- jadi kita ambil beberapa halaman lalu sortir sendiri: paling sepi di depan.
local function fetchHopServers()
    local pid = game.PlaceId
    local base = "https://games.roblox.com/v1/games/" .. pid
        .. "/servers/Public?limit=100&excludeFullGames=true"
    local margin = math.max(0, tonumber(st.hopSlotMargin) or 3)
    local pages = math.clamp(tonumber(st.hopPages) or 4, 1, 10)
    local pool, cursor = {}, nil
    for _ = 1, pages do
        local url = base .. (cursor and ("&cursor=" .. cursor) or "")
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if not ok then break end
        local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not (ok2 and type(data) == "table" and type(data.data) == "table") then break end
        for _, s in ipairs(data.data) do
            if type(s.id) == "string"
                and s.id ~= game.JobId
                and not recentJobs[s.id]
                and type(s.playing) == "number"
                and type(s.maxPlayers) == "number"
                and s.playing <= s.maxPlayers - margin then
                pool[#pool + 1] = { id = s.id, playing = s.playing }
            end
        end
        cursor = data.nextPageCursor
        if type(cursor) ~= "string" or cursor == "" then break end
        task.wait(0.3)                        -- jaga jarak biar tidak kena rate-limit
    end
    table.sort(pool, function(a, b) return a.playing < b.playing end)
    local ids = {}
    for _, s in ipairs(pool) do ids[#ids + 1] = s.id end
    return ids
end

-- ambil dari depan (paling sepi). hopPickTopPercent > 0 → random dari N% terkosong
local function takeHopServer(servers)
    if #servers == 0 then return nil end
    local pct = tonumber(st.hopPickTopPercent) or 0
    if pct <= 0 then return table.remove(servers, 1) end
    local n = math.clamp(math.floor(#servers * pct), 1, #servers)
    return table.remove(servers, math.random(1, n))
end

local function dismissTeleportError()
    pcall(function()
        local rg = game:GetService("CoreGui"):FindFirstChild("RobloxGui")
        local prompt = rg and rg:FindFirstChild("ErrorPrompt")
        if prompt then prompt.Visible = false end
    end)
end

local function serverHop()
    writeResume()
    markRecentJob(game.JobId)   -- jangan pernah pilih server yang baru ditinggalkan
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if type(q) == "function" then pcall(q, "getgenv().WisHubGaG2TameResume = true") end
    local pid = game.PlaceId
    local servers = fetchHopServers()
    local attempt = 0
    while st.autoTame and st.autoHop do
        attempt = attempt + 1
        dismissTeleportError()   -- clear any leftover "Teleport Failed" popup
        teleportFailed = false
        teleportFailResult = nil
        local jobId = takeHopServer(servers)
        if jobId then
            markRecentJob(jobId)
            pcall(function() TeleportService:TeleportToPlaceInstance(pid, jobId, LocalPlayer) end)
        else
            pcall(function() TeleportService:Teleport(pid, LocalPlayer) end)  -- matchmaking → fresh instance
        end
        local t0 = os.clock()
        while not teleportFailed and os.clock() - t0 < 60 do
            if not (st.autoTame and st.autoHop) then return false end
            task.wait(0.5)
        end
        if teleportFailed then
            local flooded = teleportFailResult == Enum.TeleportResult.Flooded
            notify(flooded and ("Rate-limited, waiting (#%d)"):format(attempt)
                or ("Server full/failed, retrying (#%d)"):format(attempt))
            task.wait(flooded and 12 or 2)  -- fast retry; back off only when rate-limited
        else
            notify(("Teleport stuck 1m, rejoining (#%d)"):format(attempt))
            task.wait(1)
        end
        if #servers == 0 then servers = fetchHopServers() end  -- refill the pool
    end
    return false
end

