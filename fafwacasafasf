local function skipLoadingScreen()
    local menu = workspace:FindFirstChild("LoadingScreenMenu")
    if not menu then return end

    local gui     = menu:WaitForChild("LoadingGui", 15)
    local variant = gui and gui:WaitForChild("Variant1Frame", 15)
    local inner   = variant and variant:WaitForChild("InnerFrame", 15)
    local counter = inner and inner:WaitForChild("CounterTxt", 15)
    -- if we can't read the counter we CANNOT confirm state — never act blindly
    if not counter then return end
    local skip = inner:FindFirstChild("SkipTxt")

    local function skippableNow()
        if string.find(counter.Text, "Fully Loaded", 1, true) then return true end
        if skip and string.find(skip.Text, "Click to skip", 1, true) and skip.TextTransparency < 1 then
            return true
        end
        return false
    end

    local waited = 0
    while counter.Parent and not skippableNow() and waited < 400 do
        task.wait(0.3)
        waited = waited + 1
    end
    if not skippableNow() then return end   -- never became skippable → don't act

    local tries = 0
    while tries < 20
        and workspace:FindFirstChild("LoadingScreenMenu")
        and LocalPlayer:GetAttribute("LoadingScreenDone") ~= true do
        pcall(function()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            task.wait(0.03)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
        pcall(function()
            local vp = workspace.CurrentCamera.ViewportSize
            VirtualInputManager:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, true, game, 0)
            task.wait(0.03)
            VirtualInputManager:SendMouseButtonEvent(vp.X / 2, vp.Y / 2, 0, false, game, 0)
        end)
        tries = tries + 1
        task.wait(0.3)
    end
end

