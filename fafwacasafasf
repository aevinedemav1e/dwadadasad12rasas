local function hasFS()
    return type(writefile) == "function" and type(readfile) == "function"
end

local function ensureDir()
    if type(makefolder) ~= "function" then return end
    pcall(function() if type(isfolder) ~= "function" or not isfolder(CFG_ROOT) then makefolder(CFG_ROOT) end end)
    pcall(function() if type(isfolder) ~= "function" or not isfolder(CFG_DIR) then makefolder(CFG_DIR) end end)
end

local function encodeState()
    local data = {}
    for _, k in ipairs(SAVE_KEYS) do data[k] = st[k] end
    local ok, enc = pcall(function() return HttpService:JSONEncode(data) end)
    if ok then return enc end
    return nil
end

local function applyDecoded(data)
    if type(data) ~= "table" then return false end
    for _, k in ipairs(SAVE_KEYS) do
        if data[k] ~= nil then st[k] = data[k] end
    end
    return true
end

local function writeResume()
    if not hasFS() then return end
    ensureDir()
    local enc = encodeState()
    if enc then pcall(writefile, RESUME_FILE, enc) end
end

local function consumeResume()
    if type(readfile) ~= "function" then return false end
    if type(isfile) == "function" and not isfile(RESUME_FILE) then return false end
    local ok, raw = pcall(readfile, RESUME_FILE)
    pcall(function() if type(delfile) == "function" then delfile(RESUME_FILE) end end)
    if not ok then return false end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 then return false end
    return applyDecoded(data)
end

consumeResume()

